# Committed CI environment — used by GitHub Actions (quality / coverage).
# Prefer this over .env.example so Sail hostnames (redis, pgsql, mailpit)
# never leak into runners that have no Docker Compose network.
#
# Pest / PHPUnit still apply phpunit.xml overrides on top for the test suite.

APP_NAME=Qompose
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

OCTANE_SERVER=frankenphp
OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=500
OCTANE_MAX_EXECUTION_TIME=120

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

RETENTION_ARCHIVED_DAYS=1095
RETENTION_ACTIVITY_LOG_DAYS=1095
RETENTION_FAILED_JOBS_HOURS=168
RETENTION_JOB_BATCHES_HOURS=48
RETENTION_NOTIFICATIONS_DAYS=90
RETENTION_AGENT_CONVERSATION_DAYS=90
RETENTION_PORTAL_GRANTS_DAYS=90

# SQLite is enough for Artisan generators; Pest swaps this via phpunit.xml.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SCOUT_DRIVER=collection

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null

FILESYSTEM_DISK=local
FILESYSTEM_THROW=false
FILESYSTEM_REPORT=false
QUEUE_CONNECTION=sync

CACHE_STORE=array

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

HEALTH_NOTIFICATIONS_ENABLED=false

AUTH_DOCUMENT_ACCESS_TIMEOUT=900

OCR_DRIVER=mock

PORTAL_SESSION_IDLE_MINUTES=15
PORTAL_SESSION_ABSOLUTE_MINUTES=240

VITE_APP_NAME="${APP_NAME}"

SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

PERMISSION_TESTING=true

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

SENTRY_ENABLE_LOGS=false
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0
