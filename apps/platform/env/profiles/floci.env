# Local Floci storage profile — safe to commit (dummy credentials).
# Applied onto .env by: composer env:floci  (or scripts/use-aws-profile.sh floci)
FILESYSTEM_DISK=s3
MAIL_MAILER=ses
OCR_DRIVER=mock
TRANSCRIPTION_DRIVER=mock
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=local
AWS_ENDPOINT=http://floci:4566
# Floci InvokeModel stubs Titan as {"outputs":[{"text":"..."}]}, not a vector.
# AppServiceProvider fakes embeddings while this hostname is set.
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=http://floci:4566
AWS_URL=http://localhost:4566
AWS_USE_PATH_STYLE_ENDPOINT=true
TEXTRACT_SNS_TOPIC_ARN=
TEXTRACT_SNS_ROLE_ARN=
TEXTRACT_RESULTS_QUEUE_URL=
TRANSCRIBE_RESULTS_QUEUE_URL=
# Blanked for a sharper reason than the two above. Those are also held shut by
# OCR_DRIVER / TRANSCRIPTION_DRIVER being mock, but scanning has no driver to
# switch: shouldRunScanConsume() in AppServiceProvider gates on the queue URL
# alone, so a leftover real-AWS URL would point scan:consume at SQS in the cloud
# while everything else talks to Floci.
#
# Blank is also the right default for a fresh clone, where the Floci queue does
# not exist yet and a consumer would fail on every poll. If you have run
# `composer floci:lambdas` and want the local chain back, re-add the URL it
# prints — switching profiles is what cleared it.
SCAN_RESULTS_QUEUE_URL=
SCAN_THUMBNAILS_ENABLED=false
