# Local Floci storage profile — safe to commit (dummy credentials).
# Applied onto .env by: composer env:floci  (or scripts/use-aws-profile.sh floci)
FILESYSTEM_DISK=s3
OCR_DRIVER=mock
TRANSCRIPTION_DRIVER=mock
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=local
AWS_ENDPOINT=http://floci:4566
AWS_URL=http://localhost:4566
AWS_USE_PATH_STYLE_ENDPOINT=true
TEXTRACT_SNS_TOPIC_ARN=
TEXTRACT_SNS_ROLE_ARN=
TEXTRACT_RESULTS_QUEUE_URL=
TRANSCRIBE_RESULTS_QUEUE_URL=
