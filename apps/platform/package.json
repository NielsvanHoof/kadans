{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "biome check --write .",
        "lint:check": "biome check .",
        "types:check": "npm run wayfinder:generate && npm run questionnaire:generate && npm run permissions:generate && npm run types:transform && tsc --noEmit",
        "wayfinder:generate": "php artisan wayfinder:generate --with-form --no-interaction",
        "questionnaire:generate": "php artisan questionnaire:generate-item-types --no-interaction",
        "permissions:generate": "php artisan tenancy:generate-permissions --no-interaction",
        "types:transform": "php artisan typescript:transform --no-interaction",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@react-aria/test-utils": "^1.0.0-rc.0",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn": "^4.16.1",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@internationalized/date": "^3.12.3",
        "@laravel/echo-react": "^2.4.0",
        "@laravel/passkeys": "^0.2.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "input-otp": "^1.4.2",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^1.25.0",
        "pusher-js": "^8.5.0",
        "react": "^19.2.0",
        "react-aria-components": "^1.20.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "usehooks-ts": "^3.1.1",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.62.3",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
