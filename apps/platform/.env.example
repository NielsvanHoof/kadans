APP_NAME=Qompose
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
# Presentation only — APP timezone stays UTC so stored timestamps are unaffected.
APP_DISPLAY_TIMEZONE=Europe/Amsterdam
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

OCTANE_SERVER=frankenphp
OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=500
OCTANE_MAX_EXECUTION_TIME=120

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Local writes a readable file. Production must not: the container filesystem is
# ephemeral, so use `stderr_json,sentry_logs` and let the log driver ship it.
# ProductionConfigurationValidator fails boot on a stack of only file channels.
LOG_STACK=single,sentry_logs

LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Data retention (days unless noted). Archived clients/dossiers are purged after archived_days.
RETENTION_ARCHIVED_DAYS=1095
RETENTION_ACTIVITY_LOG_DAYS=1095
RETENTION_FAILED_JOBS_HOURS=168
RETENTION_JOB_BATCHES_HOURS=48
RETENTION_NOTIFICATIONS_DAYS=90
RETENTION_PORTAL_GRANTS_DAYS=90

# Laravel Sail (PostgreSQL, Redis, Mailpit, Floci)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
# The Sail container is not reachable off the Docker network, so `prefer` is
# fine here. Shipped environments reach RDS over the public internet and must
# set DB_SSLMODE=verify-full plus DB_SSLROOTCERT pointing at the RDS CA bundle
# — ProductionConfigurationValidator refuses to boot without both.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem

# Scout database engine (pgsql). Tests override to "collection" for sqlite.
SCOUT_DRIVER=database
# Caps ScoutSearchFilter key hydration (Postgres IN bind limit is 65535).
SCOUT_KEY_LIMIT=1000

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Local/Sail: REMOTE_ADDR is fine (validator only runs in production/staging).
# Shipped: PRIVATE_SUBNETS. Laravel Cloud puts Cloudflare and its own ingress
# in front of the app on a private network, and the pod address is not stable
# enough to enumerate — but it is always RFC1918, which is what PRIVATE_SUBNETS
# expands to. Never REMOTE_ADDR or *; the validator rejects both.
TRUSTED_PROXIES=REMOTE_ADDR

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Use `composer env:floci` for S3 against Sail Floci, or `composer env:aws` for real AWS.
# Keep FILESYSTEM_DISK=local for CI/tests without Floci.
FILESYSTEM_DISK=local
FILESYSTEM_THROW=false
FILESYSTEM_REPORT=false
QUEUE_CONNECTION=redis
# Must exceed every job timeout (largest: GenerateDataSubjectExportJob 600s).
# ShouldBeUnique does not prevent a second worker picking up an expired reservation.
REDIS_QUEUE_RETRY_AFTER=660

# Transcription — mock (local/CI) or Amazon Transcribe (EventBridge → SQS).
# See config/transcription.php. Full vars are listed near TRANSCRIPTION_DRIVER below.
# TRANSCRIPTION_DRIVER=mock
# TRANSCRIPTION_JOB_TIMEOUT=120

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Shipped environments must use tls on BOTH the default and cache connections;
# they share this one variable, and the validator checks each separately.
# Laravel Cloud's Valkey terminates TLS with SNI and injects REDIS_HOST and
# REDIS_PASSWORD, but not the scheme — set REDIS_SCHEME=tls yourself.
REDIS_SCHEME=tcp
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Off locally so a failing check does not mail on every `schedule:run`.
# Defaults to ON in production — set HEALTH_TO_ADDRESS there or nothing is sent.
HEALTH_NOTIFICATIONS_ENABLED=false
# HEALTH_TO_ADDRESS=operations@example.com
# Ping these from an external uptime monitor so an app that is fully down is
# still noticed — in-app checks cannot report on their own absence.
# SCHEDULE_HEARTBEAT_URL=
# HORIZON_HEARTBEAT_URL=

# Require a recent password confirmation before staff view or download documents.
AUTH_DOCUMENT_ACCESS_TIMEOUT=900

# Who must hold a confirmed second factor: off | all | by_permission.
# Production refuses to boot on `off`. `by_permission` keys on the permission
# below, evaluated against the workspace the user is currently in.
SECURITY_TWO_FACTOR_ENFORCEMENT=all
SECURITY_TWO_FACTOR_PERMISSION=documents.download
# Days from account creation before enrolment is enforced. 0 requires it immediately.
SECURITY_TWO_FACTOR_GRACE_DAYS=14

# OCR: mock (default, offline) or textract (real AWS — see apps/platform/infra Pulumi stack)
OCR_DRIVER=mock

# Client portal sessions are created after redeeming a magic link. The idle
# window is extended on every portal request; the absolute one is stamped once
# and never extended. Idle must stay below SESSION_LIFETIME.
PORTAL_SESSION_IDLE_MINUTES=15
PORTAL_SESSION_ABSOLUTE_MINUTES=240
# What happens when a magic link is redeemed from an unfamiliar device or
# network: notify | block | ignore. `block` refuses (as a 404) and will strand
# clients who switch from mobile data to wifi — prefer notify.
PORTAL_NEW_DEVICE_ACTION=notify

# AWS storage: use profiles instead of hand-mixing Floci and Pulumi values.
#   composer env:floci   → Sail Floci S3 + mock OCR/transcription
#   composer env:aws     → real AWS (cached env/profiles/aws.env from sync-ocr-credentials)
# Defaults below match the Floci profile. FILESYSTEM_DISK stays local for offline CI clones.
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
# Temporary STS token when assuming the Pulumi OCR operator role (leave empty for Floci / long-lived keys).
# AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=local
AWS_ENDPOINT=http://floci:4566
AWS_URL=http://localhost:4566
AWS_USE_PATH_STYLE_ENDPOINT=true

# Textract (only when OCR_DRIVER=textract) — applied by composer env:aws / sync-ocr-credentials
# TEXTRACT_SNS_TOPIC_ARN=
# TEXTRACT_SNS_ROLE_ARN=
# TEXTRACT_RESULTS_QUEUE_URL=
# TEXTRACT_SQS_MAX_RECEIVE_COUNT=5
# laravel/ai — reuses the AWS_* credentials/region above; only override models if needed.
# Provider default is Amazon Nova Lite — requires infra/src/config.ts's Bedrock IAM
# allowlist (defaultBedrockModelArns) to include amazon.* and be deployed via
# `pulumi up`. Anthropic models need a separate per-account use-case approval.
# AI_BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0

# Per-agent provider/model overrides (config/ai.php → agents.*). Leave a model
# unset to inherit the provider default above. The OCR document overview pins an
# EU Claude Sonnet inference profile because classifying Dutch financial and
# identity documents is the quality-critical path.
# AI_DOCUMENT_OVERVIEW_MODEL=eu.anthropic.claude-sonnet-4-20250514-v1:0
# AI_DOCUMENT_OVERVIEW_PROVIDER=bedrock
# AI_CHECKLIST_DRAFT_MODEL=
# AI_DOSSIER_REMINDER_MODEL=

# Transcription: mock (default, offline) or transcribe (Amazon Transcribe — see apps/platform/infra)
TRANSCRIPTION_DRIVER=mock
# TRANSCRIPTION_JOB_TIMEOUT=120
# Keep REDIS_QUEUE_RETRY_AFTER above every job timeout (DSR export 600s, this 120s).

# Amazon Transcribe (only when TRANSCRIPTION_DRIVER=transcribe) — from `pulumi stack output`
# Completions arrive via EventBridge → SQS.
# TRANSCRIBE_RESULTS_QUEUE_URL=
# TRANSCRIBE_LANGUAGE_OPTIONS=nl-NL,en-US
# TRANSCRIBE_MAX_SPEAKERS=10
# TRANSCRIBE_OUTPUT_PREFIX=transcriptions
# TRANSCRIBE_SQS_MAX_RECEIVE_COUNT=5

VITE_APP_NAME="${APP_NAME}"

# Response hardening (config/security.php). The policy is assembled per request
# from the Vite nonce, the Vite dev server, Reverb, and the S3 document host.
# Flip SECURITY_CSP_REPORT_ONLY=true (and set SECURITY_CSP_REPORT_URI) to observe
# violations without blocking. Report-Only without a URI falls back to enforcing.
# GuardDuty tags each object in the documents bucket with its scan verdict, and
# download/preview refuse anything not explicitly clean. Off locally: there is no
# GuardDuty attached to a Floci bucket, so nothing would ever be tagged.
# ProductionConfigurationValidator rejects this being off in production/staging.
SECURITY_MALWARE_SCANNING_ENABLED=false
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
# SECURITY_CSP_REPORT_URI=
# HSTS is only emitted on HTTPS requests, so it is inert on local http://.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# Only enable once the domain is ready for the browser preload list — hard to undo.
SECURITY_HSTS_PRELOAD=false

# Sail / Docker
WWWGROUP=1000
WWWUSER=1000
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_FLOCI_PORT=4566
FORWARD_REVERB_PORT=8080

# Sentry is disabled automatically when APP_ENV is local or testing (DSN ignored).
SENTRY_ENABLE_LOGS=false
SENTRY_LARAVEL_DSN=
# Keep off. Events are attributed by tenant_id/user_id tags instead, so errors
# stay traceable without shipping names, emails, or client IPs to a third party.
SENTRY_SEND_DEFAULT_PII=false
# Trace sampling: 1.0 traces every request, which is far too expensive and noisy
# for production. Tune per environment; 0.2 is a reasonable production start.
SENTRY_TRACES_SAMPLE_RATE=0.2
# Set per deploy (the released image tag) so errors group by version and Sentry
# can show which release introduced a regression.
SENTRY_RELEASE=

# Browser SDK. A separate Sentry project from SENTRY_LARAVEL_DSN above, so a
# flood of minified JS errors cannot bury a PHP exception. Vite inlines these
# into the bundle at build time — they must be present when `npm run build`
# runs, not just at runtime — and ContentSecurityPolicy reads VITE_SENTRY_DSN to
# allow the ingest origin in connect-src. Empty DSN leaves the SDK off, which is
# what you want locally; a dev build never reports even when one is set.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT="${APP_ENV}"
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
# Must match SENTRY_RELEASE. Source maps are uploaded against this value, so a
# mismatch leaves every browser stack trace minified.
VITE_SENTRY_RELEASE="${SENTRY_RELEASE}"

# Source map upload, so production stack traces point at real source lines
# instead of `app-a1b2c3.js:1:48210`. Build-time only: set all three in CI and
# the Vite plugin activates, leave any unset and it drops out of the build. The
# auth token needs the project:releases scope and must never reach the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
