# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_NAME=Qompose
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL
APP_DISPLAY_TIMEZONE=Europe/Amsterdam

# Shipped environments: PRIVATE_SUBNETS
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Shipped environments:
# LOG_STACK=stderr_json,sentry_logs
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=qompose
DB_USERNAME=sail
DB_PASSWORD=password
DB_SSLMODE=prefer
DB_SSLROOTCERT=

# Shipped environments:
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=certs/rds-global-bundle.pem

# -----------------------------------------------------------------------------
# Redis / Valkey
# -----------------------------------------------------------------------------

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_SCHEME=tcp
REDIS_HOST=redis
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# Laravel Cloud injects CACHE_STORE, REDIS_HOST, REDIS_PASSWORD and REDIS_PORT.
# REDIS_SCHEME=tls must still be configured explicitly on Cloud.

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# Shipped environments:
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=<exact APP_URL hostname>

# -----------------------------------------------------------------------------
# Queues
# -----------------------------------------------------------------------------

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=660

# -----------------------------------------------------------------------------
# Broadcasting / Reverb
# -----------------------------------------------------------------------------

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Laravel Cloud injects REVERB_* and VITE_REVERB_* after a WebSocket application
# is attached. Do not manually reuse the local Reverb credentials on Cloud.

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@qompose.test
MAIL_FROM_NAME="${APP_NAME}"

# Staging example:
# MAIL_MAILER=ses
# MAIL_FROM_ADDRESS=no-reply@staging.qompose.nl
#
# Production example:
# MAIL_MAILER=ses
# MAIL_FROM_ADDRESS=no-reply@qompose.nl

# -----------------------------------------------------------------------------
# Filesystem / AWS
# -----------------------------------------------------------------------------

FILESYSTEM_DISK=s3
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true

AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=local
AWS_ENDPOINT=http://floci:4566
AWS_URL=http://localhost:4566
AWS_USE_PATH_STYLE_ENDPOINT=true
# Override only to point Bedrock at a local stand-in; empty uses the real regional endpoint.
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=

# On Cloud, leave AWS_ENDPOINT/AWS_URL empty and disable path-style endpoints:
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# OCR / Amazon Textract
# -----------------------------------------------------------------------------

OCR_DRIVER=mock

TEXTRACT_SNS_TOPIC_ARN=
TEXTRACT_SNS_ROLE_ARN=
TEXTRACT_RESULTS_QUEUE_URL=
TEXTRACT_SQS_WAIT_TIME=20
TEXTRACT_SQS_MAX_MESSAGES=5
TEXTRACT_SQS_MAX_RECEIVE_COUNT=5

# Shipped environments require OCR_DRIVER=textract and the bucket, SNS topic,
# publish role and results queue from the matching Pulumi stack.

# -----------------------------------------------------------------------------
# Transcription / Amazon Transcribe
# -----------------------------------------------------------------------------

TRANSCRIPTION_DRIVER=mock

TRANSCRIPTION_JOB_TIMEOUT=120
TRANSCRIBE_RESULTS_QUEUE_URL=
TRANSCRIBE_OUTPUT_PREFIX=transcriptions
TRANSCRIBE_LANGUAGE_OPTIONS=nl-NL,en-US
TRANSCRIBE_MAX_SPEAKERS=10
TRANSCRIBE_SQS_WAIT_TIME=20
TRANSCRIBE_SQS_MAX_MESSAGES=5
TRANSCRIBE_SQS_MAX_RECEIVE_COUNT=5

# Amazon Transcribe completions use EventBridge → SQS.
# TRANSCRIBE_SNS_TOPIC_ARN and TRANSCRIBE_SNS_ROLE_ARN are not used.

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------

SCOUT_DRIVER=database

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

SECURITY_TWO_FACTOR_ENFORCEMENT=off
SECURITY_TWO_FACTOR_GRACE_DAYS=14
SECURITY_MALWARE_SCANNING_ENABLED=false

# Shipped environments:
# SECURITY_TWO_FACTOR_ENFORCEMENT=all
# SECURITY_MALWARE_SCANNING_ENABLED=true

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Build-only source-map upload credentials:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------

# Nova Pro rather than the provider's Nova Lite default: this slot classifies
# payslips and identity documents from Textract field labels, and it runs off the
# request path, so the stronger model is affordable here and nowhere else.
#
# Never point this at an Anthropic model. Bedrock refuses them until an
# account-level use-case submission clears (a 404 that reads like a bad model
# id), infra withholds the IAM grant, and shipped environments reject the id at
# boot. See .ai/rules/ai.md.
AI_DOCUMENT_OVERVIEW_PROVIDER=bedrock
AI_DOCUMENT_OVERVIEW_MODEL=eu.amazon.nova-pro-v1:0
AI_DOCUMENT_OVERVIEW_TIMEOUT=45

# -----------------------------------------------------------------------------
# Horizon
# -----------------------------------------------------------------------------

HORIZON_ALLOWED_EMAILS=

# -----------------------------------------------------------------------------
# Google OAuth (optional per-user SSO — free default)
# -----------------------------------------------------------------------------

# Leave blank to hide "Log in with Google". When any key is set, set all of them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# -----------------------------------------------------------------------------
# Microsoft Entra (optional per-user SSO — Graph/calendar foundation)
# -----------------------------------------------------------------------------

# Leave blank to hide "Log in with Microsoft". When any key is set, set all of them.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
# organizations = work/school accounts only (no personal Microsoft accounts).
MICROSOFT_TENANT_ID=organizations

# Telescope
# Local-only debugging. The viewTelescope gate and request-detail redaction
# are both bypassed in local, so leave this off unless actively debugging.
TELESCOPE_ENABLED=false
